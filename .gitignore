# Dependencies (restore with: bun install)
node_modules
/.pnp
.pnp.*

# Secrets — NEVER commit these
.env
.env.local
.env.*.local
.env.development
.env.production
.env.staging
# Exception: .example templates ARE safe to commit
!.env.local.example
!.env.example

# Runtime artifacts (regenerated by launchers)
/tmp/oc-proxy.pid
/tmp/oc-proxy.log
opencode-contract-artifacts/

# Test artifacts
/tmp/v4-*
/tmp/v5-*

# Build outputs
build/
dist/
*.tsbuildinfo
.next/

# Editor / OS
.DS_Store
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
dev.log
server.log

# Skills directory (sandbox-only, not for end users)
/skills/

# zen-unlimited-linux runtime artifacts
zen-unlimited-linux/.env
zen-unlimited-linux/.zen-pids/
zen-unlimited-linux/.zen-logs/
zen-unlimited-linux/bin/
zen-unlimited-linux/node_modules/

# kiri integration artifacts
.kiri-context
docker-context.sock

# proxy-hunter runtime artifacts
proxy-hunter/custom-proxies.txt
proxy-hunter/*.json
proxy-hunter/*.yaml

# vps-proxy runtime artifacts
vps-proxy/vps-proxies.txt
vps-proxy/.public-scan-disabled
vps-proxy/.public-feeds-disabled

# Regenerable Go binary (rebuild with: cd opencode-proxy && go build -o opencode-egress-router .)
opencode-proxy/opencode-egress-router
