{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    {
      "package": "./plugins/reconcile",
      "options": {
        "intervalMs": 300000,
        "disableMissing": true,
        "userAgent": "opencode/1.19.5"
      }
    }
  ],
  "providers": {
    "opencode": {
      "name": "OpenCode Go (paid)",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://opencode.ai/inference/v1",
        "apiKey": "{env:OPENCODE_API_KEY}"
      },
      "models": {
        "kimi-k3": {
          "name": "Kimi K3",
          "capabilities": {
            "tools": true
          },
          "limit": {
            "context": 262144
          }
        },
        "kimi-k3.1-pro": {
          "name": "Kimi K3.1 Pro",
          "capabilities": {
            "tools": true
          },
          "limit": {
            "context": 1048576
          }
        },
        "claude-haiku-5-5": {
          "name": "Claude Haiku 5.5",
          "capabilities": {
            "tools": true
          }
        },
        "deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro",
          "capabilities": {
            "tools": true
          }
        },
        "glm-5.3": {
          "name": "GLM 5.3",
          "capabilities": {
            "tools": true
          }
        }
      }
    },
    "opencode-zen": {
      "name": "OpenCode Zen Free (via opencode-proxy)",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:8318",
        "apiKey": "public"
      },
      "models": {
        "glm-5.3-flash-free": {
          "name": "GLM 5.3 Flash (Free)",
          "capabilities": {
            "tools": true
          },
          "limit": {
            "context": 128000
          }
        },
        "mimo-v2.6-flash-free": {
          "name": "MiMo V2.6 Flash (Free)",
          "capabilities": {
            "tools": true
          },
          "limit": {
            "context": 1048576
          }
        },
        "deepseek-v4.1-flash-free": {
          "name": "DeepSeek V4.1 Flash (Free)",
          "capabilities": {
            "tools": true
          },
          "limit": {
            "context": 128000
          }
        },
        "longcat-2.5-free": {
          "name": "LongCat 2.5 (Free)",
          "capabilities": {
            "tools": true
          },
          "limit": {
            "context": 1048576
          }
        },
        "iceman-free": {
          "name": "Iceman (Free)",
          "capabilities": {
            "tools": true
          }
        },
        "inkling-2-small-free": {
          "name": "Inkling 2 Small (Free)",
          "capabilities": {
            "tools": true
          }
        },
        "beam-free": {
          "name": "Beam (Free)",
          "capabilities": {
            "tools": true
          }
        },
        "flint-40b-free": {
          "name": "Flint 40B (Free)",
          "capabilities": {
            "tools": true
          }
        },
        "nemotron-3.5-super-vl-free": {
          "name": "Nemotron 3.5 Super VL (Free)",
          "capabilities": {
            "tools": true
          }
        },
        "nemotron-3.5-lightning-free": {
          "name": "Nemotron 3.5 Lightning (Free)",
          "capabilities": {
            "tools": true
          }
        },
        "minimax-m3.1-flash-free": {
          "name": "MiniMax M3.1 Flash (Free)",
          "capabilities": {
            "tools": true
          },
          "limit": {
            "context": 1048576
          }
        },
        "big-pickle": {
          "name": "Big Pickle",
          "capabilities": {
            "tools": true,
            "reasoning": true
          }
        }
      }
    },
    "oc": {
      "name": "OpenCode Free (zen-unlimited, muse-spark)",
      "package": "aisdk:@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "http://localhost:20128/v1",
        "apiKey": "zen-keyless",
        "timeout": 300000,
        "headerTimeout": 30000,
        "chunkTimeout": 60000
      },
      "models": {
        "muse-spark-1.3-contributor-free": {
          "name": "Muse Spark 1.3 Free"
        }
      }
    }
  }
}