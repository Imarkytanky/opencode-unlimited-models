{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    {
      "package": "./plugins/reconcile",
      "options": {
        "intervalMs": 300000,
        "disableMissing": true,
        "userAgent": "opencode/1.19.5"
      }
    }
  ],
  "providers": {
    "opencode": {
      "name": "OpenCode Go (paid)",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://opencode.ai/inference/v1",
        "apiKey": "{env:OPENCODE_API_KEY}"
      },
      "models": {
        "kimi-k3": {
          "name": "Kimi K3",
          "capabilities": {
            "tools": true
          },
          "limit": {
            "context": 262144
          }
        },
        "kimi-k3.1-pro": {
          "name": "Kimi K3.1 Pro",
          "capabilities": {
            "tools": true
          },
          "limit": {
            "context": 1048576
          }
        },
        "claude-haiku-5-5": {
          "name": "Claude Haiku 5.5",
          "capabilities": {
            "tools": true
          }
        },
        "deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro",
          "capabilities": {
            "tools": true
          }
        },
        "glm-5.3": {
          "name": "GLM 5.3",
          "capabilities": {
            "tools": true
          }
        }
      }
    },
    "opencode-zen": {
      "name": "OpenCode Zen Free (via opencode-proxy)",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:8318",
        "apiKey": "public"
      },
      "models": {
        "glm-5.3-flash-free": {
          "name": "GLM 5.3 Flash (Free)",
          "capabilities": {
            "tools": true
          },
          "limit": {
            "context": 128000
          }
        },
        "mimo-v2.6-flash-free": {
          "name": "MiMo V2.6 Flash (Free)",
          "capabilities": {
            "tools": true
          },
          "limit": {
            "context": 1048576
          }
        },
        "deepseek-v4.1-flash-free": {
          "name": "DeepSeek V4.1 Flash (Free)",
          "capabilities": {
            "tools": true
          },
          "limit": {
            "context": 128000
          }
        },
        "longcat-2.5-free": {
          "name": "LongCat 2.5 (Free)",
          "capabilities": {
            "tools": true
          },
          "limit": {
            "context": 1048576
          }
        },
        "iceman-free": {
          "name": "Iceman (Free)",
          "capabilities": {
            "tools": true
          }
        },
        "inkling-2-small-free": {
          "name": "Inkling 2 Small (Free)",
          "capabilities": {
            "tools": true
          }
        },
        "beam-free": {
          "name": "Beam (Free)",
          "capabilities": {
            "tools": true
          }
        },
        "flint-40b-free": {
          "name": "Flint 40B (Free)",
          "capabilities": {
            "tools": true
          }
        },
        "nemotron-3.5-super-vl-free": {
          "name": "Nemotron 3.5 Super VL (Free)",
          "capabilities": {
            "tools": true
          }
        },
        "nemotron-3.5-lightning-free": {
          "name": "Nemotron 3.5 Lightning (Free)",
          "capabilities": {
            "tools": true
          }
        },
        "minimax-m3.1-flash-free": {
          "name": "MiniMax M3.1 Flash (Free)",
          "capabilities": {
            "tools": true
          },
          "limit": {
            "context": 1048576
          }
        },
        "big-pickle": {
          "name": "Big Pickle",
          "capabilities": {
            "tools": true,
            "reasoning": true
          }
        }
      }
    },
    "oc": {
      "name": "OpenCode Free (zen-unlimited, muse-spark)",
      "package": "aisdk:@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "http://localhost:20128/v1",
        "apiKey": "zen-keyless",
        "timeout": 300000,
        "headerTimeout": 30000,
        "chunkTimeout": 60000
      },
      "models": {
        "muse-spark-1.3-contributor-free": {
          "name": "Muse Spark 1.3 Free"
        }
      }
    },
    "oc-proxy-northflank": {
      "name": "OpenCode Zen Free (via oc-proxy Northflank \u2014 PRIMARY)",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://oc-proxy-northflank.invalid/v1",
        "apiKey": "{env:OC_PROXY_NF_KEY}"
      },
      "models": {
        "glm-5.3-flash-free": {
          "name": "GLM 5.3 Flash (free)",
          "capabilities": {
            "tools": true
          }
        },
        "deepseek-v4.1-flash-free": {
          "name": "DeepSeek V4.1 Flash (free)",
          "capabilities": {
            "tools": true
          }
        }
      },
      "_layerP": {
        "priority": 1,
        "deployScript": "oc-proxy/deploy-oc-proxy-northflank.sh",
        "envVar": "OC_PROXY_NF_KEY",
        "live": false,
        "notes": "Always-on, no sleep, no card, Docker-native. Free Sandbox tier (2 services, up to $20/mo). Activated by step 8 of deploy-oc-proxy-northflank.sh at the HEALTHY gate."
      }
    },
    "oc-proxy-render": {
      "name": "OpenCode Zen Free (via oc-proxy Render \u2014 FALLBACK)",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://oc-proxy-render.invalid/v1",
        "apiKey": "{env:OC_PROXY_RDR_KEY}"
      },
      "models": {
        "glm-5.3-flash-free": {
          "name": "GLM 5.3 Flash (free)",
          "capabilities": {
            "tools": true
          }
        },
        "deepseek-v4.1-flash-free": {
          "name": "DeepSeek V4.1 Flash (free)",
          "capabilities": {
            "tools": true
          }
        }
      },
      "_layerP": {
        "priority": 2,
        "deployScript": "oc-proxy/deploy-oc-proxy-render.sh",
        "envVar": "OC_PROXY_RDR_KEY",
        "live": false,
        "notes": "Free tier: 750 h/month, 15-min sleep, 5 GB bandwidth (post Apr-2026 cut), Dockerfile + WebSocket supported, no card. Pair with 5-min keep-warm cron to stay inside free quota. Deploy script: TODO (mirror of deploy-oc-proxy-hf.sh)."
      }
    },
    "oc-proxy-oracle": {
      "name": "OpenCode Zen Free (via oc-proxy Oracle+Coolify \u2014 OFF-BOX)",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://oc-proxy-oracle.invalid/v1",
        "apiKey": "{env:OC_PROXY_OC_KEY}"
      },
      "models": {
        "glm-5.3-flash-free": {
          "name": "GLM 5.3 Flash (free)",
          "capabilities": {
            "tools": true
          }
        },
        "deepseek-v4.1-flash-free": {
          "name": "DeepSeek V4.1 Flash (free)",
          "capabilities": {
            "tools": true
          }
        }
      },
      "_layerP": {
        "priority": 3,
        "deployScript": "oc-proxy/deploy-oc-proxy-oracle.sh",
        "envVar": "OC_PROXY_OC_KEY",
        "live": false,
        "notes": "Oracle Cloud Always Free ARM VM (2 OCPU / 12 GB) + Coolify (Apache-2.0 self-hosted PaaS). Hosts oc-proxy AND Layer W (SearXNG + Camofox + CloakBrowser) on the same box \u2014 full off-box loop. Card required for Oracle signup. Deploy script: TODO."
      }
    }
  },
  "providerRotation": {
    "strategy": "three-provider rotation (primary / fallback / off-box)",
    "researchSource": "download/free-hf-vercel-alternatives-top5.md (2026-11-17)",
    "threshold": 0.75,
    "primary": "oc-proxy-northflank",
    "fallback": "oc-proxy-render",
    "offBox": "oc-proxy-oracle",
    "upstreamPin": "2a41370e4ee121796bdbf65a2efeae99e80b58d1",
    "invariant": "Each provider's baseURL starts as <name>.invalid/v1 (RFC 2606) so D_thin reconcile sees the slot but no model resolves. Deploy scripts overwrite baseURL at the RUNNING gate.",
    "failover": "If primary returns 5xx or timeout > 5s, Layer B consumers should fall through to the next provider by priority. Implement in the D_thin reconcile plugin or in the OpenCode SDK client."
  }
}
