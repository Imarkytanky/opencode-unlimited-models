# .env.local.example — template. Copy to .env.local and fill in real values.
#
# IMPORTANT: never commit .env.local to git. The project's .gitignore
# already excludes it via the `.env*` rule (with an exception for .example files).
#
# Rotate any keys that were shared in chat history before relying on them.

# opencode Console API key (https://opencode.ai/console → Account → Personal API keys)
# Format: oc_sk_<32 chars>_<16 chars>
# Required for: paid models via examples/index.opencode.ts and the contract test
#              against the real gateway.
# Free-tier models via the proxy use "public" instead (no key needed).
OPENCODE_API_KEY=oc_sk_REPLACE_WITH_YOUR_KEY

# Vercel AI Gateway API key (https://vercel.com/dashboard → AI Gateway)
# Format: vck_<60 chars>
# Required for: examples/index.ts (canonical Vercel AI Gateway path).
# Note: requires paid Vercel AI Gateway credits; free-tier Vercel models
# are not accessible from external scripts.
AI_GATEWAY_API_KEY=vck_REPLACE_WITH_YOUR_KEY

# Optional: override the opencode-proxy listen port (default 8318)
# OC_PROXY_PORT=8318
