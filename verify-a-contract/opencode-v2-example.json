{
  "$schema": "https://opencode.ai/config.json",
  "plugins": ["opencode-models-discovery@2.1.2"],
  "providers": {
    "gateway": {
      "name": "Contract Test Gateway",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:18685/v1",
        "apiKey": "sk-test-contract",
        "modelsDiscovery": { "enabled": true, "smartModelName": true, "timeoutMs": 3000 }
      },
      "models": {
        "qwen3-coder": {
          "modelID": "qwen3-coder",
          "name": "Qwen3 Coder (B-explicit)",
          "capabilities": { "tools": true },
          "limit": { "context": 131072, "output": 65536 }
        }
      }
    }
  }
}
